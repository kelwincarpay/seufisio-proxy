# SeuFisio credentials
SEUFISIO_USER=
SEUFISIO_PASSWORD=
SEUFISIO_CLIENT_SECRET=
SEUFISIO_CLINIC_ID=9208

# OpenClaw access token
API_SECRET_TOKEN=

# Reposição config
MAX_ATTENDANCES_PER_HOUR=4

# Aggregator app booking (proxy resolves source -> tipo_atendimento_id).
# Optional: if unset, the source is matched by tipo_atendimento name
# ("Totalpass" / "Sessão Avulsa"). Confirmed IDs in this clinic (9208):
#   Totalpass = 13, Sessão Avulsa (Wellhub) = 12.
TIPO_TOTALPASS_ID=13
TIPO_WELLHUB_ID=12

# Cancellation rule: minimum hours before class start to allow cancelling.
CANCELLATION_MIN_HOURS=8
# Optional: status_id for a cancelled attendance. If unset, resolved by
# matching the status name containing "cancel".
CANCELLED_STATUS_ID=

# --- WhatsApp class reminders ---
# Supabase (stores notification preferences + send log). Leave empty to disable
# the notifications routes and the reminder cron.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API instance used to send WhatsApp messages.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Reminder sweep schedule (cron) and how many days ahead to scan for classes.
NOTIFICATIONS_CRON=*/15 * * * *
NOTIFY_LOOKAHEAD_DAYS=2

# Server
PORT=3000
